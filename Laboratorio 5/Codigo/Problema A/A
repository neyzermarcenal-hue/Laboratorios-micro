#define F_CPU 16000000UL

#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/atomic.h>
#include <stdint.h>
#include <stdbool.h>
#include <util/delay.h>

// =====================================
// 1. DEFINICION DE PINES
// =====================================

#define LED       PB0
#define BUZZER    PB1
#define BOTON     PD2     // INT0
#define BOTON_EMERGENCIA PD3  // INT1
#define CANAL_ADC 0       // PC0 / ADC0
#define DHT11_PIN PD4

// LCD I2C con PCF8574
#define LCD_DIRECCION 0x27

#define LCD_RS 0x01
#define LCD_EN 0x04
#define LCD_LUZ 0x08

#define LCD_D4 0x10
#define LCD_D5 0x20
#define LCD_D6 0x40
#define LCD_D7 0x80

// =====================================
// 2. TIEMPOS DEL SISTEMA
// =====================================

#define TIEMPO_LED_MS       200UL
#define TIEMPO_LCD_MS       500UL
#define TIEMPO_TEMP_MS     2000UL
#define TIEMPO_BUZZER_MS    300UL

#define TIEMPO_STANDBY_MS 10000UL
#define TIEMPO_APAGADO_MS 30000UL
#define REBOTE_BOTON_MS      50UL

// =====================================
// 3. ESTADOS DE LA FSM
// =====================================

typedef enum
{
	ACTIVO,
	STANDBY,
	APAGADO,
	EMERGENCIA
} EstadoSistema;

static EstadoSistema estado = ACTIVO;

// =====================================
// 4. VARIABLES COMPARTIDAS CON ISR
// =====================================

volatile uint32_t tiempo_ms = 0;
volatile uint8_t solicitar_adc = 0;
volatile uint8_t evento_boton = 0;
volatile uint8_t evento_emergencia = 0;

// =====================================
// 5. VARIABLES DEL PROGRAMA PRINCIPAL
// =====================================

static uint16_t valor_adc = 0;

static uint32_t ultimo_led = 0;
static uint32_t ultima_lcd = 0;
static uint32_t ultima_temp = 0;
static uint32_t ultima_actividad = 0;
static uint32_t ultimo_boton = 0;
static uint32_t inicio_buzzer = 0;

static bool buzzer_activo = false;
static bool primer_boton = true;

// =====================================
// VARIABLES DEL DHT11
// =====================================

typedef enum
{
    DHT_REPOSO,
    DHT_INICIO,
    DHT_RESPUESTA,
    DHT_RECEPCION
} EstadoDHT;

static EstadoDHT estado_dht = DHT_REPOSO;

volatile uint8_t dht_datos[5] = {0};
volatile uint8_t dht_bits = 0;
volatile uint8_t dht_fase = 0;
volatile uint8_t dht_listo = 0;
volatile uint8_t dht_error = 0;
volatile uint8_t dht_ultimo_flanco = 0;

static uint8_t temperatura = 0;
static uint8_t humedad = 0;
static bool dht_valido = false;
static uint32_t dht_inicio_ms = 0;

// =====================================
// 6. INTERRUPCION TIMER0 - 1 ms
// =====================================

ISR(TIMER0_COMPA_vect)
{
	tiempo_ms++;
}

// =====================================
// 7. INTERRUPCION TIMER1 - 100 ms
// =====================================

ISR(TIMER1_COMPA_vect)
{
	solicitar_adc = 1;
}

// =====================================
// 8. INTERRUPCION EXTERNA INT0
// =====================================

ISR(INT0_vect)
{
	evento_boton = 1;
}
// Interrupcion del boton de emergencia
ISR(INT1_vect)
{
    evento_emergencia = 1;
}

// =====================================
// 9. LECTURA SEGURA DEL TIEMPO
// =====================================

static uint32_t obtener_tiempo(void)
{
	uint32_t copia;

	ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
	{
		copia = tiempo_ms;
	}

	return copia;
}

// =====================================
// 10. CONFIGURACION TIMER0
// =====================================

static void configurar_timer0(void)
{
	TCCR0A = (1 << WGM01);
	TCCR0B = 0;

	TCNT0 = 0;
	OCR0A = 249;

	TIFR0 = (1 << OCF0A);
	TIMSK0 = (1 << OCIE0A);

	TCCR0B = (1 << CS01) | (1 << CS00);
}

// =====================================
// 11. CONFIGURACION TIMER1
// =====================================

static void configurar_timer1(void)
{
	TCCR1A = 0;
	TCCR1B = 0;

	TCNT1 = 0;
	OCR1A = 24999;

	TIFR1 = (1 << OCF1A);
	TIMSK1 = (1 << OCIE1A);

	TCCR1B = (1 << WGM12)
	| (1 << CS11)
	| (1 << CS10);
}

// =====================================
// 12. CONFIGURACION ADC
// =====================================

static void configurar_adc(void)
{
	ADMUX = (1 << REFS0) | CANAL_ADC;

	ADCSRA = (1 << ADEN)
	| (1 << ADPS2)
	| (1 << ADPS1)
	| (1 << ADPS0);

	ADCSRB = 0;
	DIDR0 |= (1 << ADC0D);
}

// =====================================
// 13. CONFIGURACION DEL PULSADOR
// =====================================

static void configurar_int0(void)
{
	DDRD &= ~(1 << BOTON);
	PORTD |= (1 << BOTON);

	EICRA = (1 << ISC01); // Flanco descendente
	EIFR = (1 << INTF0);
	EIMSK = (1 << INT0);
}


// =====================================
// FUNCIONES I2C Y LCD 16x2
// =====================================

static uint8_t lcd_luz = LCD_LUZ;

// I2C a aproximadamente 100 kHz
static void i2c_init(void)
{
    TWSR = 0;
    TWBR = 72;
    TWCR = (1 << TWEN);
}

// Devuelve 1 si el estado I2C es correcto
static uint8_t i2c_esperar(void)
{
    uint16_t intentos = 60000;

    while (!(TWCR & (1 << TWINT)))
    {
        if (--intentos == 0)
            return 0;
    }

    return 1;
}

static uint8_t i2c_escribir(uint8_t dato)
{
    TWCR = (1 << TWINT) | (1 << TWSTA)
         | (1 << TWEN);

    if (!i2c_esperar())
        return 0;

    if ((TWSR & 0xF8) != 0x08 &&
        (TWSR & 0xF8) != 0x10)
        return 0;

    TWDR = LCD_DIRECCION << 1;

    TWCR = (1 << TWINT) | (1 << TWEN);

    if (!i2c_esperar())
        return 0;

    if ((TWSR & 0xF8) != 0x18)
        return 0;

    TWDR = dato;

    TWCR = (1 << TWINT) | (1 << TWEN);

    if (!i2c_esperar())
        return 0;

    uint8_t correcto = ((TWSR & 0xF8) == 0x28);

    TWCR = (1 << TWINT) | (1 << TWEN)
         | (1 << TWSTO);

    return correcto;
}

static void lcd_pulso(uint8_t dato)
{
    i2c_escribir(dato | LCD_EN);
    _delay_us(1);
    i2c_escribir(dato & ~LCD_EN);
    _delay_us(50);
}

static void lcd_nibble(uint8_t nibble, uint8_t rs)
{
    uint8_t dato = (nibble & 0xF0) | lcd_luz;

    if (rs)
        dato |= LCD_RS;

    lcd_pulso(dato);
}

static void lcd_enviar(uint8_t valor, uint8_t rs)
{
    lcd_nibble(valor & 0xF0, rs);
    lcd_nibble((valor << 4) & 0xF0, rs);
}

static void lcd_comando(uint8_t comando)
{
    lcd_enviar(comando, 0);

    if (comando == 0x01 || comando == 0x02)
        _delay_ms(2);
}

static void lcd_caracter(char caracter)
{
    lcd_enviar((uint8_t)caracter, 1);
}

static void lcd_texto(const char *texto)
{
    while (*texto)
    {
        lcd_caracter(*texto++);
    }
}

static void lcd_posicion(uint8_t fila, uint8_t columna)
{
    uint8_t direccion = (fila == 0) ? 0x00 : 0x40;
    lcd_comando(0x80 | (direccion + columna));
}

static void lcd_numero(uint16_t numero)
{
    char texto[6];
    uint8_t i = 0;

    do
    {
        texto[i++] = '0' + (numero % 10);
        numero /= 10;
    }
    while (numero > 0);

    while (i > 0)
        lcd_caracter(texto[--i]);
}

static void lcd_init(void)
{
    _delay_ms(50);

    lcd_nibble(0x30, 0);
    _delay_ms(5);

    lcd_nibble(0x30, 0);
    _delay_us(150);

    lcd_nibble(0x30, 0);
    lcd_nibble(0x20, 0);

    lcd_comando(0x28); // 4 bits, 2 lineas
    lcd_comando(0x0C); // Pantalla encendida
    lcd_comando(0x06); // Cursor avanza
    lcd_comando(0x01); // Limpiar pantalla
}

static void lcd_retroiluminacion(uint8_t encendida)
{
    lcd_luz = encendida ? LCD_LUZ : 0;
    i2c_escribir(lcd_luz);
}

#define DHT_ESPERANDO_BAJADA  0
#define DHT_ESPERANDO_SUBIDA  1
#define DHT_FIN_RESPUESTA     2
#define DHT_INICIO_BIT       3
#define DHT_FIN_BIT          4

static void configurar_dht11(void)
{
    // Timer2: 16 MHz / 8 = 2 MHz
    // Cada cuenta equivale a 0,5 us.
    TCCR2A = 0;
    TCCR2B = (1 << CS21);
    TCNT2 = 0;

    // PD4 como entrada con pull-up
    DDRD &= ~(1 << DHT11_PIN);
    PORTD |= (1 << DHT11_PIN);

    // PCINT20 pertenece al grupo PCINT2
    PCMSK2 |= (1 << PCINT20);
    PCICR &= ~(1 << PCIE2);
    PCIFR = (1 << PCIF2);
}

static void dht_finalizar(uint8_t error)
{
    PCICR &= ~(1 << PCIE2);

    if (error)
        dht_error = 1;
    else
        dht_listo = 1;
}

// Interrupcion por cambios en PD4
ISR(PCINT2_vect)
{
    uint8_t nivel = PIND & (1 << DHT11_PIN);
    uint8_t fase = dht_fase;

    if (fase == DHT_ESPERANDO_BAJADA)
    {
        if (!nivel)
            dht_fase = DHT_ESPERANDO_SUBIDA;
    }
    else if (fase == DHT_ESPERANDO_SUBIDA)
    {
        if (nivel)
            dht_fase = DHT_FIN_RESPUESTA;
    }
    else if (fase == DHT_FIN_RESPUESTA)
    {
        if (!nivel)
            dht_fase = DHT_INICIO_BIT;
    }
    else if (fase == DHT_INICIO_BIT)
    {
        if (nivel)
        {
            TCNT2 = 0;
            dht_fase = DHT_FIN_BIT;
        }
    }
    else if (fase == DHT_FIN_BIT)
    {
        if (!nivel)
        {
            // 26-28 us es 0; 70 us es 1
            // 100 cuentas equivalen a 50 us
            uint8_t bit = (TCNT2 > 100) ? 1 : 0;

            uint8_t indice = dht_bits / 8;

            dht_datos[indice] =
                (dht_datos[indice] << 1) | bit;

            dht_bits++;

            if (dht_bits >= 40)
            {
                dht_finalizar(0);
            }
            else
            {
                dht_fase = DHT_INICIO_BIT;
            }
        }
    }
}


// =====================================
// 14. INICIALIZACION GENERAL
// =====================================


static void configurar_int1(void)
{
    DDRD &= ~(1 << BOTON_EMERGENCIA);
    PORTD |= (1 << BOTON_EMERGENCIA);

    EICRA |= (1 << ISC11);
    EICRA &= ~(1 << ISC10);

    EIFR = (1 << INTF1);
    EIMSK |= (1 << INT1);
}

static void inicializar_hardware(void)
{
    cli();

    DDRB |= (1 << LED) | (1 << BUZZER);
    PORTB &= ~((1 << LED) | (1 << BUZZER));

    configurar_timer0();
    configurar_timer1();
    configurar_adc();
    configurar_int0();
    configurar_int1();
    configurar_dht11();

    i2c_init();

    sei();

    lcd_init();
}


// =====================================
// 15. TAREA DEL LED
// =====================================

static void tarea_led(uint32_t ahora)
{
	if ((uint32_t)(ahora - ultimo_led)
	>= TIEMPO_LED_MS)
	{
		ultimo_led = ahora;
		PORTB ^= (1 << LED);
	}
}

// =====================================
// 16. TAREA DEL ADC
// =====================================

static void tarea_adc(void)
{
	if (solicitar_adc == 0)
	return;

	ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
	{
		solicitar_adc = 0;
	}

	// Iniciar conversion si no hay otra en curso
	if (!(ADCSRA & (1 << ADSC)))
	{
		ADCSRA |= (1 << ADSC);
	}
}

static void comprobar_adc(void)
{
	if (ADCSRA & (1 << ADSC))
	return;

	// ADIF indica conversion terminada
	if (ADCSRA & (1 << ADIF))
	{
		valor_adc = ADC;
		ADCSRA |= (1 << ADIF);
	}
}

// =====================================
// 17. CONTROL DEL BUZZER
// =====================================

static void activar_buzzer(uint32_t ahora)
{
	PORTB |= (1 << BUZZER);
	buzzer_activo = true;
	inicio_buzzer = ahora;
}

static void tarea_buzzer(uint32_t ahora)
{
	if (buzzer_activo &&
	(uint32_t)(ahora - inicio_buzzer)
	>= TIEMPO_BUZZER_MS)
	{
		PORTB &= ~(1 << BUZZER);
		buzzer_activo = false;
	}
}

// =====================================
// 18. ATENCION DEL PULSADOR
// =====================================

static void atender_boton(uint32_t ahora)
{
	uint8_t pendiente;

	ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
	{
		pendiente = evento_boton;
		evento_boton = 0;
	}

	if (!pendiente)
	return;

	// Antirrebote por tiempo
	if (!primer_boton &&
	(uint32_t)(ahora - ultimo_boton)
	< REBOTE_BOTON_MS)
	{
		return;
	}

	primer_boton = false;
	ultimo_boton = ahora;
	ultima_actividad = ahora;

	if (estado == STANDBY ||
    estado == APAGADO)
{
    estado = ACTIVO;
    lcd_retroiluminacion(1);
}

	if (estado != EMERGENCIA)
	{
		activar_buzzer(ahora);
	}
}


static void atender_emergencia(void)
{
    uint8_t pendiente;

    ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
    {
        pendiente = evento_emergencia;
        evento_emergencia = 0;
    }

    if (pendiente)
    {
        estado = EMERGENCIA;

        PORTB &= ~((1 << LED) | (1 << BUZZER));
        buzzer_activo = false;

        lcd_retroiluminacion(1);
    }
}


// =====================================
// 19. MAQUINA DE ESTADOS
// =====================================

static void actualizar_fsm(uint32_t ahora)
{
	uint32_t inactividad =
	(uint32_t)(ahora - ultima_actividad);

	if (estado == ACTIVO)
	{
		if (inactividad >= TIEMPO_STANDBY_MS)
		{
			estado = STANDBY;
		}
	}
	else if (estado == STANDBY)
	{
		if (inactividad >= TIEMPO_APAGADO_MS)
{
    estado = APAGADO;
    lcd_retroiluminacion(0);
}
	}
	else if (estado == APAGADO)
	{
		// Esperar un evento de despertar
	}
	else if (estado == EMERGENCIA)
	{
		// Estado seguro:
		PORTB &= ~((1 << LED) | (1 << BUZZER));
		buzzer_activo = false;
	}
}

// =====================================
// 20. TAREA LCD - PENDIENTE DE DRIVER
// =====================================

static void tarea_lcd(uint32_t ahora)
{
    // No actualizar la LCD durante la comunicacion DHT11
    if (estado_dht != DHT_REPOSO)
        return;

    if ((uint32_t)(ahora - ultima_lcd)
        < TIEMPO_LCD_MS)
        return;

    ultima_lcd = ahora;

    lcd_posicion(0, 0);

 
if (estado == ACTIVO)
{
    lcd_texto("ESTADO: ACTIVO  ");

    lcd_posicion(1, 0);
	lcd_texto("                ");
	lcd_posicion(1, 0);

    // Mostrar temperatura y humedad
    if (dht_valido)
    {
        lcd_texto("T:");
        lcd_numero(temperatura);

        lcd_texto(" H:");
        lcd_numero(humedad);

        lcd_texto(" A:");
    }
    else
    {
        lcd_texto("SIN DATO A:");
    }

    // Mostrar valor del ADC
    lcd_numero(valor_adc);

}

    else if (estado == STANDBY)
    {
        lcd_texto("ESTADO: STANDBY ");

        lcd_posicion(1, 0);
        lcd_texto("Esperando...    ");
    }
    else if (estado == APAGADO)
    {
        lcd_texto("ESTADO: APAGADO ");

        lcd_posicion(1, 0);
        lcd_texto("                ");
    }
    else if (estado == EMERGENCIA)
    {
        lcd_texto("EMERGENCIA     ");

        lcd_posicion(1, 0);
        lcd_texto("SISTEMA SEGURO ");
    }
}

// =====================================
// 21. LECTURA DEL SENSOR DHT11
// =====================================

static void tarea_temperatura(uint32_t ahora)
{
    if (estado_dht == DHT_REPOSO)
    {
        if ((uint32_t)(ahora - ultima_temp)
            < TIEMPO_TEMP_MS)
            return;

        ultima_temp = ahora;

        // Iniciar comunicacion: DATA en bajo
        PCICR &= ~(1 << PCIE2);

        PORTD &= ~(1 << DHT11_PIN);
        DDRD |= (1 << DHT11_PIN);

        dht_inicio_ms = ahora;
        estado_dht = DHT_INICIO;
        return;
    }

    if (estado_dht == DHT_INICIO)
    {
        // Mantener DATA en bajo al menos 18 ms
        if ((uint32_t)(ahora - dht_inicio_ms) < 18UL)
            return;

        ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
        {
            dht_bits = 0;
            dht_fase = DHT_ESPERANDO_BAJADA;
            dht_listo = 0;
            dht_error = 0;

            for (uint8_t i = 0; i < 5; i++)
                dht_datos[i] = 0;

            // Liberar la linea de datos
			// El modulo DHT11 tiene resistencia pull-up
			PORTD |= (1 << DHT11_PIN);
			DDRD &= ~(1 << DHT11_PIN);

			// Preparar recepcion por interrupciones
			TCNT2 = 0;
			PCIFR = (1 << PCIF2);
			PCICR |= (1 << PCIE2);
        }

        dht_inicio_ms = ahora;
        estado_dht = DHT_RECEPCION;
        return;
    }

    if (estado_dht == DHT_RECEPCION)
    {
        uint8_t datos[5];
        uint8_t listo;
        uint8_t error;

        ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
        {
            listo = dht_listo;
            error = dht_error;

            for (uint8_t i = 0; i < 5; i++)
                datos[i] = dht_datos[i];

            if (listo)
                dht_listo = 0;
        }

        if (listo)
        {
            uint8_t suma =
                datos[0] + datos[1] +
                datos[2] + datos[3];

            if (suma == datos[4])
            {
                humedad = datos[0];
                temperatura = datos[2];
                dht_valido = true;
            }
            else
            {
                dht_valido = false;
            }

            estado_dht = DHT_REPOSO;
            return;
        }

        if (error ||
            (uint32_t)(ahora - dht_inicio_ms) >= 8UL)
        {
            PCICR &= ~(1 << PCIE2);
            dht_valido = false;
            estado_dht = DHT_REPOSO;
        }
    }
}

 // =====================================
 // 22. PROGRAMA PRINCIPAL
 // =====================================

int main(void)
{
    inicializar_hardware();

    uint32_t ahora = obtener_tiempo();

    ultimo_led = ahora;
    ultima_lcd = ahora;
    ultima_temp = ahora;
    ultima_actividad = ahora;

    
while (1)
{
    ahora = obtener_tiempo();

    atender_boton(ahora);
	atender_emergencia();
	actualizar_fsm(ahora);
	tarea_buzzer(ahora);

    if (estado == ACTIVO)
    {
        tarea_led(ahora);
        tarea_adc();
        comprobar_adc();
        tarea_temperatura(ahora);
    }
    else if (estado == APAGADO)
    {
        PORTB &= ~(1 << LED);
    }

    // Actualizar la pantalla al final
    tarea_lcd(ahora);
}

    return 0;
}

