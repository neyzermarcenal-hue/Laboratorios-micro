#include <avr/interrupt.h>
#include <util/atomic.h>

#define LED_VERDE PB0
#define LED_ROJO PB1
#define BUZZER PB2
#define PIR PD2
#define UMBRAL_LDR 100

#define TIEMPO_PIR_MS 2000UL

volatile uint32_t tiempo_ms = 0;

// Timer1: interrupcion cada 1 ms
ISR(TIMER1_COMPA_vect) { //Permite medir el tiempo y comprobar si el PIR detectó movimiento durante 2 segundos.
    tiempo_ms++;
}

static void timer1_init(void) {
    TCCR1A = 0; //Limpia la onfiguracion inicial del Timer1
    TCCR1B = 0; //Reinicia la configuracion del reloj del Timer1              
    TCNT1 = 0; //Pone el contador en 0

    // 16 MHz / 64 = 250000 Hz
    // 250 ciclos = 1 ms //genera una interrupcion cada 1ms
    OCR1A = 249;  // Estabelce el valor de comparacion

    TCCR1B = (1 << WGM12) | // Configuea el modo CTC
             (1 << CS11) |
             (1 << CS10);  //Selecciona un prescaler de 64f

    TIMSK1 = (1 << OCIE1A); // Habilita la interrupción del Timer1 cuando el contador coincide con OCR1A
}

static uint32_t millis_timer(void) {
    uint32_t tiempo;

    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
        tiempo = tiempo_ms;
    }

    return tiempo;
}

// Estados de la maquina de estados finitos (Moore)
typedef enum {
    DESARMADO,
    ARMADO_AUTO,
    ARMADO_MANUAL,
    ALARMA_AUTO,
    ALARMA_MANUAL,
    SILENCIO_AUTO,
    SILENCIO_MANUAL
} Estado;

static Estado estado_actual = DESARMADO;

// UART USB por hardware (D0/D1)
// Bluetooth por software (D3/D4)

#define BT_RX PD3
#define BT_TX PD4
#define BT_BUF_SIZE 64

static volatile uint8_t bt_buffer[BT_BUF_SIZE];
static volatile uint8_t bt_cabeza = 0;
static volatile uint8_t bt_cola = 0;

// Interrupcion para recibir Bluetooth por D3
ISR(PCINT2_vect) { //Porque el Bluetooth está conectado a D3 y D4, y necesitamos recibir datos por software sin utilizar la UART física del Arduino.

    if (PIND & (1 << BT_RX)) return;

    PCMSK2 &= ~(1 << PCINT19);

    _delay_us(156);

    uint8_t dato = 0;

    for (uint8_t i = 0; i < 8; i++) {
        if (PIND & (1 << BT_RX)) {
            dato |= (1 << i);
        }

        _delay_us(104);
    }

    uint8_t siguiente =
        (uint8_t)((bt_cabeza + 1) % BT_BUF_SIZE);

    if (siguiente != bt_cola) {
        bt_buffer[bt_cabeza] = dato;
        bt_cabeza = siguiente;
    }

    PCIFR = (1 << PCIF2);
    PCMSK2 |= (1 << PCINT19);
}

// Enviar un caracter al Bluetooth por D4
static void bt_enviar_caracter(char c) {

    uint8_t sreg = SREG;
    cli(); //Deshabilita temporalmente las interrupciones globales.

    PORTD &= ~(1 << BT_TX);
    _delay_us(104);

    for (uint8_t i = 0; i < 8; i++) {

        if (c & (1 << i)) {
            PORTD |= (1 << BT_TX);
        } else {
            PORTD &= ~(1 << BT_TX);
        }

        _delay_us(104);
    }

    PORTD |= (1 << BT_TX);
    _delay_us(104);

    SREG = sreg;
}

// Modo seleccionado para el proximo armado
static uint8_t modo_seleccionado = 1; // 1 = AUTO, 0 = MANUAL


static void uart_init(void) {

    // UART USB a 9600 baudios
    UBRR0H = 0;
    UBRR0L = 103;

    UCSR0A = 0;
    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);

    // Bluetooth RX en D3
    DDRD &= ~(1 << BT_RX);
    PORTD &= ~(1 << BT_RX);

    // Bluetooth TX en D4
    PORTD |= (1 << BT_TX);
    DDRD |= (1 << BT_TX);

    // Habilitar interrupcion de D3
    PCICR |= (1 << PCIE2);
    PCMSK2 |= (1 << PCINT19);
}

static void uart_texto(const char *s) {

    while (*s) {

        // Enviar a la computadora por USB
        while (!(UCSR0A & (1 << UDRE0))) {
        }

        UDR0 = *s;

        // Enviar al celular por Bluetooth
        bt_enviar_caracter(*s);

        s++;
    }
}

static void adc_init(void) {
    ADMUX = (1 << REFS0); // AVcc, canal ADC0
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

static uint16_t leer_ldr(void) {
    ADMUX = (ADMUX & 0xF0) | 0;
    ADCSRA |= (1 << ADSC);
    while (ADCSRA & (1 << ADSC)) { }
    return ADC;
}

// Salidas de la maquina de estados Moore
static void salidas(void) {

    uint8_t verde = (estado_actual != DESARMADO);

    uint8_t rojo = (estado_actual == ALARMA_AUTO ||
                    estado_actual == ALARMA_MANUAL ||
                    estado_actual == SILENCIO_AUTO ||
                    estado_actual == SILENCIO_MANUAL);

    uint8_t buzzer = (estado_actual == ALARMA_AUTO ||
                      estado_actual == ALARMA_MANUAL);

    if (verde)
        PORTB |= (1 << LED_VERDE);
    else
        PORTB &= ~(1 << LED_VERDE);

    if (rojo)
        PORTB |= (1 << LED_ROJO);
    else
        PORTB &= ~(1 << LED_ROJO);

    if (buzzer)
        PORTB |= (1 << BUZZER);
    else
        PORTB &= ~(1 << BUZZER);
}


static void estado(void) {
    char texto[24];

    uart_texto("ESTADO:");

    switch (estado_actual) {
        case DESARMADO:
            uart_texto("DESARMADO;");
            break;

        case ARMADO_AUTO:
            uart_texto("ARMADO_AUTO;");
            break;

        case ARMADO_MANUAL:
            uart_texto("ARMADO_MANUAL;");
            break;

        case ALARMA_AUTO:
            uart_texto("ALARMA_AUTO;");
            break;

        case ALARMA_MANUAL:
            uart_texto("ALARMA_MANUAL;");
            break;

        case SILENCIO_AUTO:
            uart_texto("SILENCIO_AUTO;");
            break;

        case SILENCIO_MANUAL:
            uart_texto("SILENCIO_MANUAL;");
            break;
    }

    uart_texto(modo_seleccionado ?
               "MODO:AUTO;" : "MODO:MANUAL;");

    snprintf(texto, sizeof(texto),
    "LDR:%u;PIR:%u\r\n",
    (unsigned int)leer_ldr(),
    (unsigned int)((PIND & (1 << PIR)) != 0));

uart_texto(texto);
}

static void procesar(const char *c) {

    uart_texto("RECIBIDO:[");
    uart_texto(c);
    uart_texto("]\r\n");

    if (!strcmp(c, "ARMAR")) {

        if (estado_actual == DESARMADO) {
            estado_actual = modo_seleccionado ?
                            ARMADO_AUTO : ARMADO_MANUAL;
            uart_texto("OK:ARMADA\r\n");
        } else {
            uart_texto("ERROR:YA_ARMADA\r\n");
        }

    } else if (!strcmp(c, "DESARMAR")) {

        estado_actual = DESARMADO;
        uart_texto("OK:DESARMADA\r\n");

    
    } else if (!strcmp(c, "AUTO")) {

        if (estado_actual == DESARMADO ||
            estado_actual == ARMADO_AUTO ||
            estado_actual == ARMADO_MANUAL) {

            modo_seleccionado = 1;

            if (estado_actual == ARMADO_MANUAL) {
                estado_actual = ARMADO_AUTO;
            }

            uart_texto("OK:MODO_AUTO\r\n");

        } else {
            uart_texto("ERROR:NO_CAMBIAR_MODO_EN_ALARMA\r\n");
        }

    } else if (!strcmp(c, "MANUAL")) {

        if (estado_actual == DESARMADO ||
            estado_actual == ARMADO_AUTO ||
            estado_actual == ARMADO_MANUAL) {

            modo_seleccionado = 0;

            if (estado_actual == ARMADO_AUTO) {
                estado_actual = ARMADO_MANUAL;
            }

            uart_texto("OK:MODO_MANUAL\r\n");

        } else {
            uart_texto("ERROR:NO_CAMBIAR_MODO_EN_ALARMA\r\n");
        }


    } else if (!strcmp(c, "ALARMA")) {

        if (estado_actual == ARMADO_MANUAL) {
            estado_actual = ALARMA_MANUAL;
            uart_texto("ALARMA:ON;ZONA:MANUAL\r\n");
        } else {
            uart_texto("ERROR:REQUIERE_MANUAL_ARMADA\r\n");
        }

    } else if (!strcmp(c, "SILENCIO")) {

        if (estado_actual == ALARMA_AUTO) {
            estado_actual = SILENCIO_AUTO;
            uart_texto("OK:SIRENA_SILENCIADA\r\n");

        } else if (estado_actual == ALARMA_MANUAL) {
            estado_actual = SILENCIO_MANUAL;
            uart_texto("OK:SIRENA_SILENCIADA\r\n");

        } else {
            uart_texto("ERROR:NO_HAY_ALARMA_ACTIVA\r\n");
        }

    } else if (!strcmp(c, "RESTABLECER")) {

        if (estado_actual == ALARMA_AUTO ||
            estado_actual == SILENCIO_AUTO) {

            uint8_t ventana = (leer_ldr() < UMBRAL_LDR);
            uint8_t movimiento = ((PIND & (1 << PIR)) != 0);

            if (!ventana && !movimiento) {
                estado_actual = ARMADO_AUTO;
                uart_texto("OK:ALARMA_RESTABLECIDA\r\n");
            } else {
                uart_texto("ERROR:INTRUSION_ACTIVA\r\n");
            }

        } else {
            uart_texto("ERROR:NO_CORRESPONDE_RESTABLECER\r\n");
        }

    } else if (!strcmp(c, "APAGAR")) {

        if (estado_actual == ALARMA_MANUAL ||
            estado_actual == SILENCIO_MANUAL) {

            estado_actual = ARMADO_MANUAL;
            uart_texto("OK:ALARMA_MANUAL_APAGADA\r\n");

        } else {
            uart_texto("ERROR:NO_CORRESPONDE_APAGAR\r\n");
        }

    } else if (!strcmp(c, "ESTADO")) {

        estado();

    } else if (*c) {

        uart_texto("ERROR:COMANDO_DESCONOCIDO\r\n");
    }

    // Actualizar salidas Moore
    salidas();
}

static void recibir_caracter(
    char c,
    char *comando,
    uint8_t *indice
) {
    if (c == '\r' || c == '\n') {

        if (*indice > 0) {
            comando[*indice] = '\0';
            procesar(comando);
            *indice = 0;
        }

    } else if (*indice < 19) {

        if (c >= 'a' && c <= 'z') {
            c -= 32;
        }

        comando[(*indice)++] = c;

    } else {

        *indice = 0;
        uart_texto("ERROR:COMANDO_LARGO\r\n");
    }
}

static void recibir(void) {

    static char comando_usb[20];
    static char comando_bt[20];

    static uint8_t indice_usb = 0;
    static uint8_t indice_bt = 0;

    // Recibir comandos desde la computadora
    while (UCSR0A & (1 << RXC0)) {

        recibir_caracter(
            (char)UDR0,
            comando_usb,
            &indice_usb
        );
    }

    // Recibir comandos desde el Bluetooth
    while (bt_cola != bt_cabeza) {

        char c = (char)bt_buffer[bt_cola];

        bt_cola =
            (uint8_t)((bt_cola + 1) % BT_BUF_SIZE);

        recibir_caracter(
            c,
            comando_bt,
            &indice_bt
        );
    }
}
// Variables para confirmar movimiento del PIR
static uint32_t inicio_pir = 0;
static uint8_t contando_pir = 0;
static uint8_t pir_confirmado = 0;

int main(void) {

    // Configurar salidas
    DDRB |= (1 << LED_VERDE) |
            (1 << LED_ROJO) |
            (1 << BUZZER);

    // Configurar PIR como entrada
    DDRD &= ~(1 << PIR);
    PORTD &= ~(1 << PIR);

    // Inicializaciones
    uart_init();
    adc_init();
    timer1_init();
    sei();

    estado_actual = DESARMADO;
    salidas();

    uart_texto("SISTEMA DE ALARMA LISTO\r\n");
    uart_texto("COMANDOS: ARMAR DESARMAR AUTO MANUAL ALARMA SILENCIO RESTABLECER APAGAR ESTADO\r\n");

    while (1) {

        recibir();

        uint16_t valor_ldr = leer_ldr();
        uint8_t ventana = (valor_ldr < UMBRAL_LDR);

        uint8_t pir_actual =
            ((PIND & (1 << PIR)) != 0);

        uint32_t ahora = millis_timer();

        // Confirmación del PIR
        if ((estado_actual == ARMADO_AUTO ||
             estado_actual == ALARMA_AUTO ||
             estado_actual == SILENCIO_AUTO) && pir_actual) {

            if (!contando_pir) {
                inicio_pir = ahora;
                contando_pir = 1;
            }

            if ((uint32_t)(ahora - inicio_pir) >= TIEMPO_PIR_MS) { //Comprueba si transcurrieron 2000 milisegundos desde que comenzo la deteccion del PIR.
                pir_confirmado = 1;
            }

        } else {
            contando_pir = 0;
            pir_confirmado = 0;
        }

        uint8_t movimiento = pir_confirmado;
        uint8_t intrusion = ventana || movimiento;

        // Transición automática Moore
        if (estado_actual == ARMADO_AUTO && intrusion) {

            estado_actual = ALARMA_AUTO;

            if (ventana) {
                uart_texto("ALARMA:ON;ZONA:VENTANA\r\n");
            } else {
                uart_texto("ALARMA:ON;ZONA:MOVIMIENTO\r\n");
            }
        }

        salidas();
    }

    return 0;
}
