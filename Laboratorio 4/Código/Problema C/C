#define F_CPU 16000000UL
#include <avr/io.h>
#include <util/delay.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <stdint.h>

#define LED_VERDE PB0
#define LED_ROJO PB1
#define BUZZER PB2
#define BOTON PD2
#define UMBRAL_LDR 450

static uint8_t armado = 0;
static uint8_t automatico = 1;
static uint8_t alarma = 0;
static uint8_t silencio = 0;
static char comando[20];
static uint8_t indice = 0;

static void uart_init(void) {
    UBRR0H = 0;
    UBRR0L = 103;  // 9600 baudios con reloj de 16 MHz
    UCSR0A = 0;
    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

static void uart_char(char c) {
    while (!(UCSR0A & (1 << UDRE0))) { }
    UDR0 = c;
}

static void uart_texto(const char *s) {
    while (*s) uart_char(*s++);
}

static void adc_init(void) {
    ADMUX = (1 << REFS0); // AVcc, canal ADC0
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

static uint16_t leer_ldr(void) {
    ADMUX = (ADMUX & 0xF0) | 0;
    ADCSRA |= (1 << ADSC);
    while (ADCSRA & (1 << ADSC)) { }
    return ADC;
}

static void salidas(void) {
    if (armado) PORTB |= (1 << LED_VERDE);
    else PORTB &= ~(1 << LED_VERDE);

    if (alarma) PORTB |= (1 << LED_ROJO);
    else PORTB &= ~(1 << LED_ROJO);

    if (alarma && !silencio) PORTB |= (1 << BUZZER);
    else PORTB &= ~(1 << BUZZER);
}

static void estado(void) {
    char texto[22];
    uart_texto(armado ? "ARMADA;" : "DESARMADA;");
    uart_texto(automatico ? "MODO:AUTO;" : "MODO:MANUAL;");
    uart_texto(alarma ? "ALARMA:ON;" : "ALARMA:OFF;");
    uart_texto(silencio ? "SIRENA:SILENCIO;" : "SIRENA:NORMAL;");
    snprintf(texto, sizeof(texto), "LDR:%u\r\n", leer_ldr());
    uart_texto(texto);
}

static void procesar(const char *c) {
    if (!strcmp(c, "ARMAR")) {
        armado = 1;
        alarma = 0;
        silencio = 0;
        uart_texto("OK:ARMADA\r\n");
    } else if (!strcmp(c, "DESARMAR")) {
        armado = 0;
        alarma = 0;
        silencio = 0;
        uart_texto("OK:DESARMADA\r\n");
    } else if (!strcmp(c, "AUTO")) {
        automatico = 1;
        uart_texto("OK:MODO_AUTO\r\n");
    } else if (!strcmp(c, "MANUAL")) {
        automatico = 0;
        uart_texto("OK:MODO_MANUAL\r\n");
    } else if (!strcmp(c, "SILENCIO")) {
        silencio = 1;
        uart_texto("OK:SIRENA_SILENCIADA\r\n");
    } else if (!strcmp(c, "ALARMA")) {
        if (armado && !automatico) {
            alarma = 1;
            silencio = 0;
            uart_texto("ALARMA:ON;ZONA:MANUAL\r\n");
        } else {
            uart_texto("ERROR:REQUIERE_MANUAL_Y_ARMADA\r\n");
        }
    } else if (!strcmp(c, "ESTADO")) {
        estado();
    } else if (*c) {
        uart_texto("ERROR:COMANDO_DESCONOCIDO\r\n");
    }
    salidas();
}

static void recibir(void) {
    while (UCSR0A & (1 << RXC0)) {
        char c = UDR0;
        if (c == '\r' || c == '\n') {
            if (indice) {
                comando[indice] = '\0';
                procesar(comando);
                indice = 0;
            }
        } else if (indice < sizeof(comando) - 1) {
            if (c >= 'a' && c <= 'z') c -= 32;
            comando[indice++] = c;
        } else {
            indice = 0;
            uart_texto("ERROR:COMANDO_LARGO\r\n");
        }
    }
}

int main(void) {
    DDRB |= (1 << LED_VERDE) | (1 << LED_ROJO) | (1 << BUZZER);
    DDRD &= ~(1 << BOTON);
    PORTD |= (1 << BOTON);
    uart_init();
    adc_init();
    salidas();
    uart_texto("SISTEMA DE ALARMA LISTO\r\n");
    uart_texto("COMANDOS: ARMAR DESARMAR AUTO MANUAL SILENCIO ALARMA ESTADO\r\n");

    uint8_t anterior = 0;
    while (1) {
        recibir();
        uint8_t ventana = (leer_ldr() < UMBRAL_LDR);
        uint8_t movimiento = !(PIND & (1 << BOTON));
        uint8_t intrusion = ventana || movimiento;

        if (armado && automatico && intrusion && !alarma) {
            alarma = 1;
            silencio = 0;
            if (ventana) uart_texto("ALARMA:ON;ZONA:VENTANA\r\n");
            else uart_texto("ALARMA:ON;ZONA:MOVIMIENTO\r\n");
        }
        if (armado && automatico && intrusion && !anterior && alarma) {
            uart_texto(ventana ? "EVENTO:VENTANA\r\n" : "EVENTO:MOVIMIENTO\r\n");
        }
        anterior = intrusion;
        salidas();
        _delay_ms(30);
    }
}
