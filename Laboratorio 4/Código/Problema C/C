SoftwareSerial bluetooth(3, 4); // RX=D3, TX=D4

#define LED_VERDE PB0
#define LED_ROJO PB1
#define BUZZER PB2
#define PIR PD2
#define UMBRAL_LDR 100

#define TIEMPO_PIR_MS 2000UL

volatile uint32_t tiempo_ms = 0;

// Timer1: interrupcion cada 1 ms
ISR(TIMER1_COMPA_vect) {
    tiempo_ms++;
}

static void timer1_init(void) {
    TCCR1A = 0;
    TCCR1B = 0;
    TCNT1 = 0;

    // 16 MHz / 64 = 250000 Hz
    // 250 ciclos = 1 ms
    OCR1A = 249;

    TCCR1B = (1 << WGM12) |
             (1 << CS11) |
             (1 << CS10);

    TIMSK1 = (1 << OCIE1A);
}

static uint32_t millis_timer(void) {
    uint32_t tiempo;

    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
        tiempo = tiempo_ms;
    }

    return tiempo;
}

// Estados de la maquina de estados finitos (Moore)
typedef enum {
    DESARMADO,
    ARMADO_AUTO,
    ARMADO_MANUAL,
    ALARMA_AUTO,
    ALARMA_MANUAL,
    SILENCIO_AUTO,
    SILENCIO_MANUAL
} Estado;

static Estado estado_actual = DESARMADO;

// Modo seleccionado para el proximo armado
static uint8_t modo_seleccionado = 1; // 1 = AUTO, 0 = MANUAL

// Buffer para recibir comandos por Bluetooth

static void uart_init(void) {
    Serial.begin(9600);      // Computadora por USB
    bluetooth.begin(9600);   // Celular por HC-05
}

static void uart_texto(const char *s) {
    Serial.print(s);       // Respuesta a la computadora
    bluetooth.print(s);    // Respuesta al celular
}

static void adc_init(void) {
    ADMUX = (1 << REFS0); // AVcc, canal ADC0
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

static uint16_t leer_ldr(void) {
    ADMUX = (ADMUX & 0xF0) | 0;
    ADCSRA |= (1 << ADSC);
    while (ADCSRA & (1 << ADSC)) { }
    return ADC;
}

// Salidas de la maquina de estados Moore
static void salidas(void) {

    uint8_t verde = (estado_actual != DESARMADO);

    uint8_t rojo = (estado_actual == ALARMA_AUTO ||
                    estado_actual == ALARMA_MANUAL ||
                    estado_actual == SILENCIO_AUTO ||
                    estado_actual == SILENCIO_MANUAL);

    uint8_t buzzer = (estado_actual == ALARMA_AUTO ||
                      estado_actual == ALARMA_MANUAL);

    if (verde)
        PORTB |= (1 << LED_VERDE);
    else
        PORTB &= ~(1 << LED_VERDE);

    if (rojo)
        PORTB |= (1 << LED_ROJO);
    else
        PORTB &= ~(1 << LED_ROJO);

    if (buzzer)
        PORTB |= (1 << BUZZER);
    else
        PORTB &= ~(1 << BUZZER);
}


static void estado(void) {
    char texto[24];

    uart_texto("ESTADO:");

    switch (estado_actual) {
        case DESARMADO:
            uart_texto("DESARMADO;");
            break;

        case ARMADO_AUTO:
            uart_texto("ARMADO_AUTO;");
            break;

        case ARMADO_MANUAL:
            uart_texto("ARMADO_MANUAL;");
            break;

        case ALARMA_AUTO:
            uart_texto("ALARMA_AUTO;");
            break;

        case ALARMA_MANUAL:
            uart_texto("ALARMA_MANUAL;");
            break;

        case SILENCIO_AUTO:
            uart_texto("SILENCIO_AUTO;");
            break;

        case SILENCIO_MANUAL:
            uart_texto("SILENCIO_MANUAL;");
            break;
    }

    uart_texto(modo_seleccionado ?
               "MODO:AUTO;" : "MODO:MANUAL;");

    snprintf(texto, sizeof(texto),
         "LDR:%u;PIR:%u\r\n",
         leer_ldr(),
         (unsigned int)((PIND & (1 << PIR)) != 0));

    uart_texto(texto);
}

static void procesar(const char *c) {

    uart_texto("RECIBIDO:[");
    uart_texto(c);
    uart_texto("]\r\n");

    if (!strcmp(c, "ARMAR")) {

        if (estado_actual == DESARMADO) {
            estado_actual = modo_seleccionado ?
                            ARMADO_AUTO : ARMADO_MANUAL;
            uart_texto("OK:ARMADA\r\n");
        } else {
            uart_texto("ERROR:YA_ARMADA\r\n");
        }

    } else if (!strcmp(c, "DESARMAR")) {

        estado_actual = DESARMADO;
        uart_texto("OK:DESARMADA\r\n");

    
    } else if (!strcmp(c, "AUTO")) {

        if (estado_actual == DESARMADO ||
            estado_actual == ARMADO_AUTO ||
            estado_actual == ARMADO_MANUAL) {

            modo_seleccionado = 1;

            if (estado_actual == ARMADO_MANUAL) {
                estado_actual = ARMADO_AUTO;
            }

            uart_texto("OK:MODO_AUTO\r\n");

        } else {
            uart_texto("ERROR:NO_CAMBIAR_MODO_EN_ALARMA\r\n");
        }

    } else if (!strcmp(c, "MANUAL")) {

        if (estado_actual == DESARMADO ||
            estado_actual == ARMADO_AUTO ||
            estado_actual == ARMADO_MANUAL) {

            modo_seleccionado = 0;

            if (estado_actual == ARMADO_AUTO) {
                estado_actual = ARMADO_MANUAL;
            }

            uart_texto("OK:MODO_MANUAL\r\n");

        } else {
            uart_texto("ERROR:NO_CAMBIAR_MODO_EN_ALARMA\r\n");
        }


    } else if (!strcmp(c, "ALARMA")) {

        if (estado_actual == ARMADO_MANUAL) {
            estado_actual = ALARMA_MANUAL;
            uart_texto("ALARMA:ON;ZONA:MANUAL\r\n");
        } else {
            uart_texto("ERROR:REQUIERE_MANUAL_ARMADA\r\n");
        }

    } else if (!strcmp(c, "SILENCIO")) {

        if (estado_actual == ALARMA_AUTO) {
            estado_actual = SILENCIO_AUTO;
            uart_texto("OK:SIRENA_SILENCIADA\r\n");

        } else if (estado_actual == ALARMA_MANUAL) {
            estado_actual = SILENCIO_MANUAL;
            uart_texto("OK:SIRENA_SILENCIADA\r\n");

        } else {
            uart_texto("ERROR:NO_HAY_ALARMA_ACTIVA\r\n");
        }

    } else if (!strcmp(c, "RESTABLECER")) {

        if (estado_actual == ALARMA_AUTO ||
            estado_actual == SILENCIO_AUTO) {

            uint8_t ventana = (leer_ldr() < UMBRAL_LDR);
            uint8_t movimiento = ((PIND & (1 << PIR)) != 0);

            if (!ventana && !movimiento) {
                estado_actual = ARMADO_AUTO;
                uart_texto("OK:ALARMA_RESTABLECIDA\r\n");
            } else {
                uart_texto("ERROR:INTRUSION_ACTIVA\r\n");
            }

        } else {
            uart_texto("ERROR:NO_CORRESPONDE_RESTABLECER\r\n");
        }

    } else if (!strcmp(c, "APAGAR")) {

        if (estado_actual == ALARMA_MANUAL ||
            estado_actual == SILENCIO_MANUAL) {

            estado_actual = ARMADO_MANUAL;
            uart_texto("OK:ALARMA_MANUAL_APAGADA\r\n");

        } else {
            uart_texto("ERROR:NO_CORRESPONDE_APAGAR\r\n");
        }

    } else if (!strcmp(c, "ESTADO")) {

        estado();

    } else if (*c) {

        uart_texto("ERROR:COMANDO_DESCONOCIDO\r\n");
    }

    // Actualizar salidas Moore
    salidas();
}

static void recibir_caracter(
    char c,
    char *comando,
    uint8_t *indice
) {
    if (c == '\r' || c == '\n') {

        if (*indice > 0) {
            comando[*indice] = '\0';
            procesar(comando);
            *indice = 0;
        }

    } else if (*indice < 19) {

        if (c >= 'a' && c <= 'z') {
            c -= 32;
        }

        comando[(*indice)++] = c;

    } else {

        *indice = 0;
        uart_texto("ERROR:COMANDO_LARGO\r\n");
    }
}

static void recibir(void) {

    static char comando_usb[20];
    static char comando_bt[20];

    static uint8_t indice_usb = 0;
    static uint8_t indice_bt = 0;

    // Comandos desde la computadora
    while (Serial.available() > 0) {
        recibir_caracter(
            (char)Serial.read(),
            comando_usb,
            &indice_usb
        );
    }

    // Comandos desde el celular
    while (bluetooth.available() > 0) {
        recibir_caracter(
            (char)bluetooth.read(),
            comando_bt,
            &indice_bt
        );
    }
}

void setup() {

    // Configurar LED verde, LED rojo y buzzer como salidas
    DDRB |= (1 << LED_VERDE) |
            (1 << LED_ROJO) |
            (1 << BUZZER);

    // Configurar PIR como entrada
    DDRD &= ~(1 << PIR);
    PORTD &= ~(1 << PIR);

    // Inicializar UART y ADC
    uart_init();
    adc_init();
    timer1_init();
    sei();

    // Estado inicial de la maquina Moore
    estado_actual = DESARMADO;
    salidas();

    uart_texto("SISTEMA DE ALARMA LISTO\r\n");
    uart_texto("COMANDOS: ARMAR DESARMAR AUTO MANUAL ALARMA SILENCIO RESTABLECER APAGAR ESTADO\r\n");

}

// Variables del filtro PIR
static uint32_t inicio_pir = 0;
static uint8_t contando_pir = 0;
static uint8_t pir_confirmado = 0;

void loop() {

        // Procesar comandos recibidos por Bluetooth
        recibir();

        // Leer sensores
uint16_t valor_ldr = leer_ldr();

uint8_t ventana = (valor_ldr < UMBRAL_LDR);

// Lectura directa del PIR
uint8_t pir_actual = ((PIND & (1 << PIR)) != 0);

// Tiempo actual del sistema
uint32_t ahora = millis_timer();

// Filtro de 2 segundos para el PIR
if ((estado_actual == ARMADO_AUTO ||
     estado_actual == ALARMA_AUTO ||
     estado_actual == SILENCIO_AUTO) && pir_actual) {
    if (!contando_pir) {
        inicio_pir = ahora;
        contando_pir = 1;
    }

    if ((uint32_t)(ahora - inicio_pir) >= TIEMPO_PIR_MS) {
        pir_confirmado = 1;
    }

} else {
    contando_pir = 0;
    pir_confirmado = 0;
}

// Movimiento confirmado
uint8_t movimiento = pir_confirmado;

// Intrusion por cualquiera de los sensores
uint8_t intrusion = ventana || movimiento;

        
        // Transicion automatica de la maquina Moore
        if (estado_actual == ARMADO_AUTO && intrusion) {

            estado_actual = ALARMA_AUTO;

            if (ventana) {
                uart_texto("ALARMA:ON;ZONA:VENTANA\r\n");
            } else {
                uart_texto("ALARMA:ON;ZONA:MOVIMIENTO\r\n");
            }


        }


        // Actualizar las salidas segun el estado Moore
        salidas();

        
        // Sin retardo para recibir comandos UART a tiempo
    }

