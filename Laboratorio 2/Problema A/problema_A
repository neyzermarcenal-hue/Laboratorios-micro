.include "m328pdef.inc"

.def temp    = r16
.def dato    = r17 ; Guarda el patrón de LEDs que corresponde a una fila.
.def indice  = r18 ; Indica qué fila estamos mostrando.
.def figura  = r19 ; Guarda cuál dibujo está seleccionado
.def mascara = r20 ; Se utiliza para seleccionar una sola fila de la matriz.

; Registros para el mensaje
.def posicion = r21
.def columna = r22
.def contador = r23

.equ LARGO_MENSAJE = 101

.org 0x0000
    rjmp reset


reset:

    ; Configuro el Stack
    ldi temp, HIGH(RAMEND)
    out SPH, temp

    ldi temp, LOW(RAMEND)
    out SPL, temp

    ; PORTD son las filas de la matriz
    ldi temp, 0xFF
    out DDRD, temp

    ; Empiezo con todas las filas apagadas
    ldi temp, 0xFF
    out PORTD, temp


    ; PC0 a PC5 son 6 columnas
    ldi temp, 0x3F
    out DDRC, temp

    ; Columnas apagadas
    ldi temp, 0x00
    out PORTC, temp


    ; PB0 y PB1 son los botones
    ; PB2 y PB3 son las otras 2 columnas
    ldi temp, 0b00001100
    out DDRB, temp

    ; Activo pull-up en PB0 y PB1
    ldi temp, 0b00000011
    out PORTB, temp


ldi figura, 2
    ; Empiezo desde la primera columna del mensaje
    clr posicion

main:

    ; Boton 1 selecciona UWU
    sbis PINB, PB0
    rjmp SELECCION_UWU

    ; Boton 2 selecciona XD
    sbis PINB, PB1
    rjmp SELECCION_XD

    cpi figura, 0
    breq MOSTRAR_UWU

    cpi figura, 1
    breq MOSTRAR_XD

    ; Si no es 0 ni 1, muestro el mensaje
    rjmp MOSTRAR_MENSAJE


SELECCION_UWU:

    ldi figura, 0
    rjmp MOSTRAR_UWU


SELECCION_XD:

    ldi figura, 1
    rjmp MOSTRAR_XD


; =========================
; Mostrar UWU
; =========================

MOSTRAR_UWU:

    ldi indice, 0


BUCLE_UWU:

    rcall MOSTRAR_FILA_UWU

    inc indice

    cpi indice, 8
    brlo BUCLE_UWU

    rjmp main


; =========================
; Mostrar XD
; =========================

MOSTRAR_XD:

    ldi indice, 0


BUCLE_XD:

    rcall MOSTRAR_FILA_XD

    inc indice

    cpi indice, 8
    brlo BUCLE_XD

    rjmp main

; =========================
; Mostrar mensaje 
; =========================

MOSTRAR_MENSAJE:
    ldi contador, 35 ; repito varias veces la misma osicion para que el desplazamiento no sea demasiado rápido

REFRESCAR_MENSAJE:
    ldi indice, 0

BUCLE_MENSAJE:
    rcall MOSTRAR_FILA_MENSAJE

    inc indice

    cpi indice, 8 
    brlo BUCLE_MENSAJE

    dec contador
    brne REFRESCAR_MENSAJE

    ;Cuando termine de refrescar la imagen, avanzo una columna en el mensaje
    inc posicion

    cpi posicion, LARGO_MENSAJE
    brlo CONTINUAR_MENSAJE

    clr posicion

CONTINUAR_MENSAJE:
    rjmp main


; =========================
; Filas UWU
; =========================

MOSTRAR_FILA_UWU:

    ; Apago todas las filas
    ldi temp, 0xFF
    out PORTD, temp

    ; Apago primeras 6 columnas
    ldi temp, 0x00
    out PORTC, temp

    ; Apago PB2 y PB3
    in temp, PORTB
    andi temp, 0b11110011
    out PORTB, temp


    ; Selecciono la fila
    ldi mascara, 1
    mov temp, indice


DESPLAZA_UWU:

    tst temp
    breq FILA_UWU_LISTA

    lsl mascara
    dec temp

    rjmp DESPLAZA_UWU


FILA_UWU_LISTA:

    ; Prendo solamente la fila actual
    in temp, PORTD
    com mascara
    and temp, mascara
    out PORTD, temp


    ; Busco el patron UWU
    ldi ZH, HIGH(UWU*2)
    ldi ZL, LOW(UWU*2)

    add ZL, indice
    clr temp
    adc ZH, temp

    lpm dato, Z


    rcall ESCRIBIR_COLUMNAS
    rcall DELAY

    ret


; =========================
; Filas XD
; =========================

MOSTRAR_FILA_XD:

    ; Apago todas las filas
    ldi temp, 0xFF
    out PORTD, temp

    ; Apago primeras 6 columnas
    ldi temp, 0x00
    out PORTC, temp

    ; Apago PB2 y PB3
    in temp, PORTB
    andi temp, 0b11110011
    out PORTB, temp


    ; Selecciono la fila
    ldi mascara, 1
    mov temp, indice


DESPLAZA_XD:

    tst temp
    breq FILA_XD_LISTA

    lsl mascara
    dec temp

    rjmp DESPLAZA_XD


FILA_XD_LISTA:

    ; Prendo solamente la fila actual
    in temp, PORTD
    com mascara
    and temp, mascara
    out PORTD, temp


    ; Busco el patron XD
    ldi ZH, HIGH(XD*2)
    ldi ZL, LOW(XD*2)

    add ZL, indice
    clr temp
    adc ZH, temp

    lpm dato, Z


    rcall ESCRIBIR_COLUMNAS
    rcall DELAY

    ret

; =========================
; Filas del mensaje
; =========================

MOSTRAR_FILA_MENSAJE:

    ldi temp, 0xFF
    out PORTD, temp

    ldi temp, 0x00
    out PORTC, temp

    in temp, PORTB
    andi temp, 0b11110011
    out PORTB, temp

    ldi mascara, 1
    mov temp, indice

DESPLAZA_FILA_MENSAJE:

    tst temp
    breq FILA_MENSAJE_LISTA

    lsl mascara
    dec temp

    rjmp DESPLAZA_FILA_MENSAJE

FILA_MENSAJE_LISTA:

    in temp, PORTD
    com mascara
    and temp, mascara
    out PORTD, temp

; Formo los 8 bits que se ven en pantalla
    clr dato

    ldi columna, 0

    ARMAR_FILA:

    ; Z apunta al mensaje
    ldi ZH, HIGH(MENSAJE*2)
    ldi ZL, LOW(MENSAJE*2)

    ; Sumo la posición actual
    add ZL, posicion
    clr temp
    adc ZH, temp

    ; Sumo la columna que estoy moestrando
    add ZL, columna
    clr temp
    adc ZH, temp

    ; Leo la columna del mensaje
    lpm mascara, Z

    mov temp, indice

BUSCAR_BIT_FILA:

    tst temp
    breq BIT_FILA_LISTO

    lsr mascara
    dec temp

    rjmp BUSCAR_BIT_FILA

BIT_FILA_LISTO:

    ; Si el bit 0 está apagaddo no hago nada
    sbrs mascara, 0
    rjmp SIGUIENTE_COLUMNA

    ; Si está prendido, pongo un 1 en la columna corresponiendte deñ dato
    ldi mascara, 1
    mov temp, columna

DESPLAZA_COLUMNA:

    tst temp
    breq COLUMNA_LISTA

    lsl mascara
    dec temp

    rjmp  DESPLAZA_COLUMNA

COLUMNA_LISTA:

    or dato, mascara

SIGUIENTE_COLUMNA:

    inc columna

    cpi columna, 8
    brlo ARMAR_FILA

    ; Mando los 8 bits a la matriz

    rcall ESCRIBIR_COLUMNAS

    rcall DELAY

    ret



; =========================
; Escritura de columnas
; =========================

ESCRIBIR_COLUMNAS:

    ; Las primeras 6 columnas van por PORTC
    mov temp, dato
    andi temp, 0b00111111
    out PORTC, temp


    ; Columna 7 en PB2
    sbrc dato, 6
    sbi PORTB, PB2

    sbrs dato, 6
    cbi PORTB, PB2


    ; Columna 8 en PB3
    sbrc dato, 7
    sbi PORTB, PB3

    sbrs dato, 7
    cbi PORTB, PB3

    ret


; =========================
; Dibujo UWU
; =========================

UWU:

    .db 0b00000000, 0b00110110
    .db 0b00110110, 0b00000000
    .db 0b01001001, 0b01001001
    .db 0b00110110, 0b00000000


; =========================
; Dibujo XD
; =========================

XD:

    .db 0b10101110, 0b10101001
    .db 0b01001001, 0b01001001
    .db 0b01001001, 0b10101001
    .db 0b10101110, 0b00000000


; =========================
; Mensaje VAMOS MARCELOOOO
;
; cada byte represena UNA COLUMNA de una letra
; se deja una columna en 0 entre las letras
;
; =========================

MENSAJE:

    ; Espacio inicial para que entre desde la derecha
    .db 0x00, 0x00, 0x00, 0x00
    .db 0x00, 0x00, 0x00, 0x00

    ; V
    .db 0b00011111, 0b00100000
    .db 0b01000000, 0b00100000
    .db 0b00011111, 0b00000000

    ; A
    .db 0b01111110, 0b00001001
    .db 0b00001001, 0b00001001
    .db 0b01111110, 0b00000000

    ; M
    .db 0b01111111, 0b00000010
    .db 0b00000100, 0b00000010
    .db 0b01111111, 0b00000000

    ; O
    .db 0b00111110, 0b01000001
    .db 0b01000001, 0b01000001
    .db 0b00111110, 0b00000000

    ; S
    .db 0b01000110, 0b01001001
    .db 0b01001001, 0b01001001
    .db 0b00110001, 0b00000000

    ; Espacio
    .db 0x00, 0x00

    ; M
    .db 0b01111111, 0b00000010
    .db 0b00000100, 0b00000010
    .db 0b01111111, 0b00000000

    ; A
    .db 0b01111110, 0b00001001
    .db 0b00001001, 0b00001001
    .db 0b01111110, 0b00000000

    ; R
    .db 0b01111111, 0b00001001
    .db 0b00011001, 0b00101001
    .db 0b01000110, 0b00000000

    ; C
    .db 0b00111110, 0b01000001
    .db 0b01000001, 0b01000001
    .db 0b00100010, 0b00000000

    ; E
    .db 0b01111111, 0b01001001
    .db 0b01001001, 0b01001001
    .db 0b01000001, 0b00000000

    ; L
    .db 0b01111111, 0b01000000
    .db 0b01000000, 0b01000000
    .db 0b01000000, 0b00000000

    ; O
    .db 0b00111110, 0b01000001
    .db 0b01000001, 0b01000001
    .db 0b00111110, 0b00000000

    ; O
    .db 0b00111110, 0b01000001
    .db 0b01000001, 0b01000001
    .db 0b00111110, 0b00000000

    ; O
    .db 0b00111110, 0b01000001
    .db 0b01000001, 0b01000001
    .db 0b00111110, 0b00000000

    ; O
    .db 0b00111110, 0b01000001
    .db 0b01000001, 0b01000001
    .db 0b00111110, 0b00000000

    ; Espacio final
    .db 0x00, 0x00, 0x00, 0x00
    .db 0x00, 0x00, 0x00, 0x00


; =========================
; Delay
; =========================

DELAY:

    ldi r24, 30


D1:

    ldi r25, 50


D2:

    dec r25
    brne D2

    dec r24
    brne D1

    ret
