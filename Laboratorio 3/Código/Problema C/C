
#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdio.h>
#include <avr/interrupt.h>

// Pin de datos del LED WS2812
#define LED_WS2812 PD7   // D7 - Matriz WS2812B

#define RGB_ROJO  PB0    // D8
#define RGB_VERDE PB2    // D10
#define RGB_AZUL  PB3    // D11

// Enviar un byte al WS2812 a 16 MHz
// Cada bit dura 20 ciclos de reloj (1,25 us)
static inline __attribute__((always_inline))
void ws2812_enviar_byte(uint8_t dato)
{
    uint8_t contador = 8;

    asm volatile(
        "1:                         \n\t"
        "sbi %[puerto], %[pin]       \n\t"
        "nop                        \n\t"
        "nop                        \n\t"
        "sbrs %[dato], 7            \n\t"
        "cbi %[puerto], %[pin]       \n\t"
        "sbrc %[dato], 7            \n\t"
        "nop                        \n\t"
        "nop                        \n\t"
        "nop                        \n\t"
        "nop                        \n\t"
        "nop                        \n\t"
        "cbi %[puerto], %[pin]       \n\t"
        "lsl %[dato]                \n\t"
        "dec %[contador]            \n\t"
        "brne 1b                    \n\t"
        : [dato] "+r" (dato),
          [contador] "+r" (contador)
       : [puerto] "I" (_SFR_IO_ADDR(PORTD)),
  [pin] "I" (LED_WS2812)
        : "memory"
    );
}

// Establecer el color del WS2812
void ws2812_color(uint8_t rojo, uint8_t verde, uint8_t azul)
{
    // Guardar el estado de las interrupciones
    uint8_t estado = SREG;

    cli();

    // Enviar los colores en orden GRB
    ws2812_enviar_byte(verde);
    ws2812_enviar_byte(rojo);
    ws2812_enviar_byte(azul);

    // Restaurar las interrupciones
    SREG = estado;

    // Tiempo de reinicio del WS2812
    _delay_us(80);
}

void configurar_RGB(void)
{
    DDRB |= (1 << RGB_ROJO) |
            (1 << RGB_VERDE) |
            (1 << RGB_AZUL);

    PORTB &= ~((1 << RGB_ROJO) |
               (1 << RGB_VERDE) |
               (1 << RGB_AZUL));
}

void RGB_apagar(void)
{
    PORTB &= ~((1 << RGB_ROJO) |
               (1 << RGB_VERDE) |
               (1 << RGB_AZUL));
}

void RGB_rojo(void)
{
    RGB_apagar();
    PORTB |= (1 << RGB_ROJO);
}

void RGB_verde(void)
{
    RGB_apagar();
    PORTB |= (1 << RGB_VERDE);
}

void RGB_azul(void)
{
    RGB_apagar();
    PORTB |= (1 << RGB_AZUL);
}

// Valores de calibracion de los celofanes

#define NUM_LEDS 64

void matriz_color(uint8_t rojo, uint8_t verde, uint8_t azul)
{
    uint8_t estado = SREG;

    cli();

    for (uint8_t i = 0; i < NUM_LEDS; i++)
    {
        ws2812_enviar_byte(verde);
        ws2812_enviar_byte(rojo);
        ws2812_enviar_byte(azul);
    }

    SREG = estado;

    _delay_us(80);
}

// Valores de calibracion de los celofanes

// ROJO
#define R_ROJO 799
#define G_ROJO 672
#define B_ROJO 688

// VERDE
#define R_VERDE 658
#define G_VERDE 768
#define B_VERDE 731

// AZUL
#define R_AZUL 589
#define G_AZUL 756
#define B_AZUL 777

// AMARILLO
#define R_AMARILLO 826
#define G_AMARILLO 813
#define B_AMARILLO 697

// Tolerancia para reconocer los colores
#define TOLERANCIA 10000UL

// Ultimo color detectado
uint8_t ultimo_color = 0;

// Configuracion del ADC
void configurar_ADC(void)
{
    // Referencia AVcc (5 V) y canal ADC0 (A0)
    ADMUX = (1 << REFS0);

    // Habilitar ADC y prescaler de 128
    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);
}

// Leer la fotocelda
uint16_t leer_ADC(void)
{
    // Iniciar conversion
    ADCSRA |= (1 << ADSC);

    // Esperar a que termine
    while (ADCSRA & (1 << ADSC));

    // Devolver valor entre 0 y 1023
    return ADC;
}

// Configuracion de UART a 9600 baudios
void configurar_UART(void)
{
    UBRR0H = 0;
    UBRR0L = 103;

    // Habilitar transmision y recepcion
    UCSR0B = (1 << TXEN0) | (1 << RXEN0);

    // 8 bits de datos, 1 bit de parada
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

// Enviar texto por UART
void enviar_texto(const char *texto)
{
    while (*texto)
    {
        while (!(UCSR0A & (1 << UDRE0)));

        UDR0 = *texto++;
    }
}

// Configurar servomotor con Timer1
void configurar_servo(void)
{
    // D9 (PB1) como salida
    DDRB |= (1 << PB1);

    // Timer1 en Fast PWM, salida OC1A
    TCCR1A = (1 << COM1A1) | (1 << WGM11);

    TCCR1B = (1 << WGM13) |
             (1 << WGM12) |
             (1 << CS11);

    // Periodo de 20 ms (50 Hz)
    ICR1 = 39999;

    // Posicion central aproximada
    OCR1A = 3000;
}

// Mover servo a un angulo
void mover_servo(uint8_t angulo)
{
    if (angulo > 180)
        angulo = 180;

    // Pulsos de 0,9 ms a 2,1 ms
    OCR1A = 1800 + ((uint32_t)angulo * 2400UL / 180UL);
}

// Revisar comandos recibidos por UART
void revisar_UART(void)
{
    char opcion;

    // Comprobar si llego un caracter
    if (!(UCSR0A & (1 << RXC0)))
        return;

    opcion = UDR0;

    switch (opcion)
    {
        case '1':
            mover_servo(20);
            enviar_texto("Servo: posicion 1\r\n");
            break;

        case '2':
            mover_servo(60);
            enviar_texto("Servo: posicion 2\r\n");
            break;

        case '3':
            mover_servo(110);
            enviar_texto("Servo: posicion 3\r\n");
            break;

        case '4':
            mover_servo(160);
            enviar_texto("Servo: posicion 4\r\n");
            break;

        case '0':
            mover_servo(90);
            enviar_texto("Servo: centro 90 grados\r\n");
            break;

        case '\r':
        case '\n':
            break;

        default:
            enviar_texto("Opcion no valida\r\n");
            break;
    }
}

// Esperar revisando UART para no perder comandos
void esperar_con_UART(uint16_t tiempo_ms)
{
    while (tiempo_ms > 0)
    {
        revisar_UART();
        _delay_ms(1);
        tiempo_ms--;
    }
}

// Calcular diferencia al cuadrado
uint32_t diferencia_cuadrada(uint16_t a, uint16_t b)
{
    int32_t diferencia = (int32_t)a - b;
    return (uint32_t)(diferencia * diferencia);
}

// Comparar mediciones con un color calibrado
uint32_t calcular_distancia(
    uint16_t r, uint16_t g, uint16_t b,
    uint16_t ref_r, uint16_t ref_g, uint16_t ref_b)
{
    return diferencia_cuadrada(r, ref_r) +
           diferencia_cuadrada(g, ref_g) +
           diferencia_cuadrada(b, ref_b);
}

// Detectar el color mas parecido
uint8_t detectar_color(uint16_t r, uint16_t g, uint16_t b)
{
    uint32_t distancias[4];

    distancias[0] = calcular_distancia(
        r, g, b, R_ROJO, G_ROJO, B_ROJO);

    distancias[1] = calcular_distancia(
        r, g, b, R_VERDE, G_VERDE, B_VERDE);

    distancias[2] = calcular_distancia(
        r, g, b, R_AZUL, G_AZUL, B_AZUL);

    distancias[3] = calcular_distancia(
        r, g, b, R_AMARILLO, G_AMARILLO, B_AMARILLO);

    uint32_t menor = distancias[0];
    uint8_t color = 1;

    for (uint8_t i = 1; i < 4; i++)
    {
        if (distancias[i] < menor)
        {
            menor = distancias[i];
            color = i + 1;
        }
    }

    if (menor > TOLERANCIA)
        return 0;

    return color;
}

// Mover el servo segun el color detectado
void clasificar_color(uint8_t color)
{
    switch (color)
    {
        case 1:
            enviar_texto("COLOR DETECTADO: ROJO\r\n");

            if (ultimo_color != color)
                mover_servo(20);

            matriz_color(50, 0, 0);    // Rojo
            break;

        case 2:
            enviar_texto("COLOR DETECTADO: VERDE\r\n");

            if (ultimo_color != color)
                mover_servo(60);

            matriz_color(0, 50, 0);    // Verde
            break;

        case 3:
            enviar_texto("COLOR DETECTADO: AZUL\r\n");

            if (ultimo_color != color)
                mover_servo(110);

            matriz_color(0, 0, 50);    // Azul
            break;

        case 4:
            enviar_texto("COLOR DETECTADO: AMARILLO\r\n");

            if (ultimo_color != color)
                mover_servo(160);

            matriz_color(50, 50, 0);   // Amarillo
            break;

        default:
            enviar_texto("COLOR: DESCONOCIDO\r\n");

            matriz_color(0, 0, 0);     // Matriz apagada
            break;
    }

    ultimo_color = color;
}
int main(void)
{
    uint16_t rojo, verde, azul;
    uint8_t color;
    char mensaje[64];

   // Configurar pin de datos del WS2812
   // Configurar D7 para la matriz WS2812B
    DDRD |= (1 << LED_WS2812);
    PORTD &= ~(1 << LED_WS2812);

// Configurar LED RGB
configurar_RGB();

    // Inicializar componentes
    configurar_ADC();
    configurar_UART();
    configurar_servo();

    // Centrar el servomotor al iniciar
    mover_servo(90);
    esperar_con_UART(2000);

    enviar_texto("\r\nCLASIFICADOR DE COLORES\r\n");
    enviar_texto("Servo centrado en 90 grados\r\n");
    enviar_texto("1 = 20 grados\r\n");
    enviar_texto("2 = 60 grados\r\n");
    enviar_texto("3 = 110 grados\r\n");
    enviar_texto("4 = 160 grados\r\n");
    enviar_texto("0 = Centrar servo\r\n");

    while (1)
    {

        // Encender rojo del LED RGB y medir
        RGB_rojo();
        esperar_con_UART(300);
        rojo = leer_ADC();

        // Encender verde del LED RGB y medir
        RGB_verde();
        esperar_con_UART(300);
        verde = leer_ADC();

        // Encender azul del LED RGB y medir
        RGB_azul();
        esperar_con_UART(300);
        azul = leer_ADC();

        // Apagar el LED RGB
        RGB_apagar();

        // Mostrar mediciones
        snprintf(mensaje, sizeof(mensaje),
                 "Rojo: %u | Verde: %u | Azul: %u\r\n",
                 rojo, verde, azul);

        enviar_texto(mensaje);

        // Detectar automaticamente el color
        color = detectar_color(rojo, verde, azul);

        // Mostrar el color y mover el servomotor
        clasificar_color(color);

        enviar_texto("--------------------\r\n");

        // Esperar antes de repetir
        esperar_con_UART(1500);
    }
}

